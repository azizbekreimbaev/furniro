<%- include('includes/header') %>

  <link rel="stylesheet" type="text/css" href="/css/users.css" />

  <body>

    <div class="users-container">

      <% if(!member) { %>

        <div class="navigation-menu">

          <a href="/admin/" class="nav-brand">
            <span class="brand-icon">F</span>
            <span class="brand-text">Furni</span>
          </a>

          <ul class="nav justify-content-center">

            <li class="nav-item">
              <a class="nav-link active" href="/admin/">
                Home
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/admin/signup">
                SignUp
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link login-link" href="/admin/login">
                Login
              </a>
            </li>

          </ul>

          <div class="nav-decoration">
            <span></span>
            <span></span>
          </div>

        </div>


        <div class="users-frame">

          <div class="login-required-card">

            <div class="login-required-icon">
              <span>F</span>
            </div>

            <span class="access-small-title">
              ADMIN ACCESS
            </span>

            <h1>
              Please login first
            </h1>

            <p>
              You need to sign in before accessing and managing
              registered users.
            </p>

            <a href="/admin/login" class="access-login-btn">
              Login to continue
              <span>→</span>
            </a>

            <div class="access-home-link">
              or
              <a href="/admin/">return home</a>
            </div>

          </div>

        </div>


        <% } else { %>


          <div class="navigation-menu">

            <a href="/admin/" class="nav-brand">
              <span class="brand-icon">F</span>
              <span class="brand-text">Furniro</span>
            </a>

            <ul class="nav justify-content-center">

              <li class="nav-item">
                <a class="nav-link" href="/admin/">
                  Home
                </a>
              </li>

              <li class="nav-item">
                <a class="nav-link" href="/admin/product/getall">
                  Menu
                </a>
              </li>

              <li class="nav-item">
                <a class="nav-link active" href="/admin/members/all">
                  Users
                </a>
              </li>

              <li class="nav-item" onclick="return confirm('Do you really want to logout?')">
                <a class="nav-link logout-link" href="/admin/logout">
                  Logout
                </a>
              </li>

            </ul>


            <div class="nav-decoration">
              <span></span>
              <span></span>
            </div>

          </div>


          <div class="users-frame">

            <div class="board">


              <div class="users-header">

                <div class="users-title">

                  <span class="section-small-title">
                    USER MANAGEMENT
                  </span>

                  <h1>
                    All Users
                  </h1>

                  <p>
                    View registered users and manage their account status.
                  </p>

                </div>


                <div class="users-summary">

                  <span class="summary-label">
                    TOTAL USERS
                  </span>

                  <strong>
                    <%= users.length %>
                  </strong>

                </div>

              </div>


              <div class="user-table-card">

                <div class="table-scroll">

                  <table class="table users-table">

                    <thead>

                      <tr>

                        <th scope="col">
                          No
                        </th>

                        <th scope="col">
                          User
                        </th>

                        <th scope="col">
                          Phone
                        </th>

                        <th scope="col">
                          Status
                        </th>

                      </tr>

                    </thead>


                    <tbody>

                      <% users.map(function(value, index) { %>

                        <tr>

                          <td>

                            <span class="table-number">
                              <%= index + 1 %>
                            </span>

                          </td>


                          <td>

                            <div class="user-info">

                              <div class="user-avatar">

                                <%= value.memberNick ? value.memberNick.charAt(0).toUpperCase() : 'U' %>

                              </div>


                              <div class="user-name-content">

                                <strong>
                                  <%= value.memberNick || 'Unknown' %>
                                </strong>

                                <span>
                                  Registered member
                                </span>

                              </div>

                            </div>

                          </td>


                          <td>

                            <div class="phone-cell">

                              <span class="phone-icon">

                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                                19.79 19.79 0 0 1-8.63-3.07
                                19.5 19.5 0 0 1-6-6
                                19.79 19.79 0 0 1-3.07-8.67
                                A2 2 0 0 1 3.89 2h3
                                a2 2 0 0 1 2 1.72
                                c.12.9.33 1.78.62 2.63
                                a2 2 0 0 1-.45 2.11
                                L7.79 9.73
                                a16 16 0 0 0 6 6
                                l1.27-1.27
                                a2 2 0 0 1 2.11-.45
                                c.85.29 1.73.5 2.63.62
                                A2 2 0 0 1 22 16.92z"></path>
                                </svg>

                              </span>

                              <span>
                                <%= value.memberPhone || 'NO PHONE' %>
                              </span>

                            </div>

                          </td>


                          <td>

                            <select class="spec-select member-status" id="<%= value._id %>">

                              <option value="ACTIVE" <%=value.memberStatus==='ACTIVE' ? 'selected' : '' %>
                                >
                                ACTIVE
                              </option>

                              <option value="BLOCK" <%=value.memberStatus==='BLOCK' ? 'selected' : '' %>
                                >
                                BLOCK
                              </option>

                              <option value="DELETE" <%=value.memberStatus==='DELETE' ? 'selected' : '' %>
                                >
                                DELETE
                              </option>

                            </select>

                          </td>

                        </tr>

                        <% }) %>

                    </tbody>

                  </table>

                </div>

              </div>


              <% if(users.length===0) { %>

                <div class="empty-users">

                  <div class="empty-icon">
                    U
                  </div>

                  <h3>
                    No users yet
                  </h3>

                  <p>
                    Registered users will appear here.
                  </p>

                </div>

                <% } %>


            </div>

          </div>

          <% } %>

    </div>


    <script type="text/javascript" src="/js/users.js"></script>

  </body>

  <%- include('includes/footer') %>