<%- include('includes/header') %>

  <link rel="stylesheet" type="text/css" href="/css/home.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

  <body>
    <div class="home-container">
      <div class="navigation-menu">
        <div class="nav-brand">
          <span class="brand-icon">F</span>
          <span class="brand-text">Furniro</span>
        </div>

        <ul class="nav justify-content-center">

          <li class="nav-item">
            <a class="nav-link active" href="/admin">
              Home
            </a>
          </li>

          <% if(!member) { %>

            <li class="nav-item">
              <a class="nav-link" href="/admin/signup">
                Signup
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link login-link" href="/admin/login">
                Login
              </a>
            </li>

            <% } else { %>

              <li class="nav-item">
                <a class="nav-link" href="/admin/product/getall">
                  Menu
                </a>
              </li>

              <li class="nav-item">
                <a class="nav-link" href="/admin/members/all">
                  Users
                </a>
              </li>

              <li class="nav-item" onclick="return confirm('Do you want to logout?')">
                <a class="nav-link logout-link" href="/admin/logout">
                  Logout
                </a>
              </li>

              <% } %>

        </ul>

        <div class="nav-decoration">
          <span></span>
          <span></span>
        </div>
      </div>

      <div class="animation-frame">
        <div class="furniture-animation">

          <div class="furniture-bg-circle"></div>

          <!-- FLOOR -->
          <div class="furniture-floor"></div>

          <!-- LAMP -->
          <div class="furniture-piece furniture-lamp">
            <div class="lamp-light"></div>
            <div class="lamp-shade"></div>
            <div class="lamp-pole"></div>
            <div class="lamp-base"></div>
          </div>

          <!-- PLANT -->
          <div class="furniture-piece furniture-plant">
            <div class="plant-leaf leaf-a"></div>
            <div class="plant-leaf leaf-b"></div>
            <div class="plant-leaf leaf-c"></div>
            <div class="plant-leaf leaf-d"></div>
            <div class="plant-pot"></div>
          </div>

          <!-- SOFA -->
          <div class="furniture-piece furniture-sofa">
            <div class="sofa-back"></div>

            <div class="sofa-seat"></div>

            <div class="sofa-arm sofa-left"></div>
            <div class="sofa-arm sofa-right"></div>

            <div class="sofa-cushion cushion-left"></div>
            <div class="sofa-cushion cushion-right"></div>

            <div class="sofa-leg sofa-leg-left"></div>
            <div class="sofa-leg sofa-leg-right"></div>
          </div>

          <!-- TABLE -->
          <div class="furniture-piece furniture-table">
            <div class="table-top"></div>
            <div class="table-leg table-left"></div>
            <div class="table-leg table-right"></div>

            <div class="table-book"></div>
          </div>

          <!-- CHAIR -->
          <div class="furniture-piece furniture-chair">
            <div class="chair-back"></div>
            <div class="chair-seat"></div>

            <div class="chair-leg chair-left"></div>
            <div class="chair-leg chair-right"></div>
          </div>

          <!-- DECORATIONS -->
          <div class="furniture-dot dot-one"></div>
          <div class="furniture-dot dot-two"></div>

        </div>
      </div>
    </div>

    <script type="text/javascript" src="/js/home.js"></script>
  </body>

  <%- include('includes/footer') %>